# Docker Desktop PostgreSQL configuration for local AegisFlow development.
POSTGRES_DB=aegisflow
POSTGRES_USER=aegisflow
POSTGRES_PASSWORD=replace-this-with-a-local-development-password
POSTGRES_PORT=5432

# Used directly by the app/CLI/Alembic (aegisflow.config.get_settings).
# Must match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://aegisflow:replace-this-with-a-local-development-password@localhost:5432/aegisflow